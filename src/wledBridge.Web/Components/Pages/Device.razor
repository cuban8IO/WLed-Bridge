@page "/devices"
@implements IDisposable
@using Microsoft.AspNetCore.Components
@using Microsoft.EntityFrameworkCore
@using wledBridge.Application.Abstractions.Controllers
@using wledBridge.Application.Abstractions.Midi
@using wledBridge.Application.Abstractions.Persistence
@using wledBridge.Domain.Controllers
@inject IMidiPortFactory PortFactory
@inject IApplicationDbContext Db
@inject ISnackbar Snackbar

<PageTitle>Device</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">@(_editingDeviceId is null ? "Device" : $"Device bearbeiten: {_deviceName}")</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    @if (_editingDeviceId is null)
    {
        <text>Beliebigen MIDI-Controller anlernen: verbinden, "Anlernen" klicken, am Controller drücken/drehen,
        Typ und LED-Fähigkeit angeben. Am Ende als Gerät speichern und auf der
        <MudLink Href="devices/test">Device-Test-Seite</MudLink> testen.</text>
    }
    else
    {
        <text>Vorhandene Controls umbenennen, Typ/LED anpassen oder entfernen. Zum Hinzufügen weiterer
        Befehle verbinden, "Anlernen" klicken und am Controller drücken/drehen.</text>
    }
</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Verbindung</MudText>
    <MudGrid>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="MIDI Eingang" @bind-Value="_selectedInput" Disabled="IsConnected">
                @foreach (var name in _inputDevices)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="MIDI Ausgang" @bind-Value="_selectedOutput" Disabled="IsConnected">
                @foreach (var name in _outputDevices)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
    <MudStack Row="true" Class="mt-3" Spacing="2" AlignItems="AlignItems.Center">
        @if (IsConnected)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => { Disconnect(); Snackbar.Add("Getrennt", Severity.Normal); })">Trennen</MudButton>
            <MudText Color="Color.Success">Verbunden</MudText>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Connect" Disabled="@(_selectedInput is null || _selectedOutput is null)">Verbinden</MudButton>
        }
    </MudStack>
</MudPaper>

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">Raw MIDI Monitor</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _rawLog.Clear())">Leeren</MudButton>
            </MudStack>
            <div style="height: 220px; overflow-y: auto; font-family: monospace; font-size: 0.8rem;">
                @foreach (var line in _rawLog)
                {
                    <div>@line</div>
                }
            </div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h6">Erkannte Control-Events</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _controlLog.Clear())">Leeren</MudButton>
            </MudStack>
            <div style="height: 220px; overflow-y: auto; font-family: monospace; font-size: 0.8rem;">
                @foreach (var line in _controlLog)
                {
                    <div>@line</div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-2">Anlernen</MudText>

    @if (_pendingCandidate is null)
    {
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartLearning" Disabled="@(!IsConnected || _isLearning)">
                @(_isLearning ? "Warte auf Eingabe..." : "Anlernen")
            </MudButton>
            @if (_isLearning)
            {
                <MudButton Variant="Variant.Outlined" OnClick="CancelLearning">Abbrechen</MudButton>
            }
        </MudStack>
        @if (_isLearning)
        {
            <MudText Typo="Typo.body2" Class="mt-2">Jetzt die Taste/den Regler am Controller betätigen.</MudText>
        }
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">
            Erkannt: ch@(_pendingCandidate.Value.Channel.ToString("00")) status=0x@(_pendingCandidate.Value.CommandCode.ToString("X2")) data1=@_pendingCandidate.Value.DataNumber
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="4">
                <MudTextField T="string" Label="Name" @bind-Value="_pendingName" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="ControlType" Label="Typ" @bind-Value="_pendingType">
                    <MudSelectItem T="ControlType" Value="ControlType.Pad">Pad</MudSelectItem>
                    <MudSelectItem T="ControlType" Value="ControlType.Button">Taster</MudSelectItem>
                    <MudSelectItem T="ControlType" Value="ControlType.Encoder">Encoder</MudSelectItem>
                    <MudSelectItem T="ControlType" Value="ControlType.Fader">Fader/Poti</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="LedCapability" Label="LED" @bind-Value="_pendingLed">
                    <MudSelectItem T="LedCapability" Value="LedCapability.None">Keine</MudSelectItem>
                    <MudSelectItem T="LedCapability" Value="LedCapability.Single">Einzelne LED</MudSelectItem>
                    <MudSelectItem T="LedCapability" Value="LedCapability.Bar">LED-Leiste/Ring</MudSelectItem>
                    <MudSelectItem T="LedCapability" Value="LedCapability.Rgb">RGB</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (_pendingType is ControlType.Encoder or ControlType.Fader)
        {
            <MudSwitch T="bool" @bind-Value="_pendingIsRelative" Label="Endlos-Regler (relativ, nicht absolut)" Color="Color.Primary" Class="mt-2" />
        }
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmLearnedControl" Disabled="@(string.IsNullOrWhiteSpace(_pendingName))">Übernehmen</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="CancelLearning">Abbrechen</MudButton>
        </MudStack>
    }
</MudPaper>

@if (_learnedControls.Count > 0)
{
    <MudPaper Class="pa-4 mb-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">Gelernte Controls</MudText>
        <MudTable Items="_learnedControls" Dense="true">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Typ</MudTh>
                <MudTh>LED</MudTh>
                <MudTh>Adresse</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="min-width:150px;">
                    <MudTextField T="string" Value="@context.Name" ValueChanged="@(v => context.Name = v)" Margin="Margin.Dense" />
                </MudTd>
                <MudTd Style="min-width:140px;">
                    <MudSelect T="ControlType" Value="@context.Type" ValueChanged="@(v => context.Type = v)" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem T="ControlType" Value="ControlType.Pad">Pad</MudSelectItem>
                        <MudSelectItem T="ControlType" Value="ControlType.Button">Taster</MudSelectItem>
                        <MudSelectItem T="ControlType" Value="ControlType.Encoder">Encoder</MudSelectItem>
                        <MudSelectItem T="ControlType" Value="ControlType.Fader">Fader/Poti</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd Style="min-width:170px;">
                    <MudSelect T="LedCapability" Value="@context.LedCapability" ValueChanged="@(v => context.LedCapability = v)" Dense="true" Margin="Margin.Dense">
                        <MudSelectItem T="LedCapability" Value="LedCapability.None">Keine</MudSelectItem>
                        <MudSelectItem T="LedCapability" Value="LedCapability.Single">Einzelne LED</MudSelectItem>
                        <MudSelectItem T="LedCapability" Value="LedCapability.Bar">LED-Leiste/Ring</MudSelectItem>
                        <MudSelectItem T="LedCapability" Value="LedCapability.Rgb">RGB</MudSelectItem>
                    </MudSelect>
                    @if (context.Type is ControlType.Encoder or ControlType.Fader)
                    {
                        <MudCheckBox T="bool" Value="@context.IsRelative" ValueChanged="@(v => context.IsRelative = v)" Label="relativ" Dense="true" />
                    }
                </MudTd>
                <MudTd>ch@(context.Channel.ToString("00")) 0x@(context.CommandCode.ToString("X2")) #@context.DataNumber</MudTd>
                <MudTd>
                    <MudStack Row="true" Spacing="1">
                        @if (context.LedCapability != LedCapability.None)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => TestLed(context))">LED testen</MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveLearnedControl(context))">Entfernen</MudButton>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-2">@(_editingDeviceId is null ? "Konfiguration speichern" : "Änderungen speichern")</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
            <MudTextField T="string" Label="Gerätename" @bind-Value="_deviceName" Style="max-width: 260px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveConfiguration" Disabled="@(string.IsNullOrWhiteSpace(_deviceName))">@(_editingDeviceId is null ? "Speichern" : "Aktualisieren")</MudButton>
        </MudStack>
        @if (_savedDeviceId is not null)
        {
            <MudText Color="Color.Success" Class="mt-2">Gespeichert. Jetzt auf der <MudLink Href="devices/test">Device-Test-Seite</MudLink> laden &amp; testen.</MudText>
        }
    </MudPaper>
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "editDeviceId")]
    public string? EditDeviceIdRaw { get; set; }

    private IReadOnlyList<string> _inputDevices = [];
    private IReadOnlyList<string> _outputDevices = [];
    private string? _selectedInput;
    private string? _selectedOutput;

    private IMidiInputPort? _input;
    private IMidiOutputPort? _output;

    private readonly List<string> _rawLog = [];
    private readonly List<string> _controlLog = [];

    private bool _isLearning;
    private (int Channel, int CommandCode, int DataNumber)? _pendingCandidate;
    private string _pendingName = "";
    private ControlType _pendingType = ControlType.Button;
    private LedCapability _pendingLed = LedCapability.None;
    private bool _pendingIsRelative;

    private readonly List<LearnedControlItem> _learnedControls = [];
    private Dictionary<(int Channel, int CommandCode, int DataNumber), LearnedControlItem> _recognizer = [];
    private string _deviceName = "";
    private Guid? _savedDeviceId;
    private Guid? _editingDeviceId;
    private Guid? _loadedForEditId;

    private bool IsConnected => _input is not null;

    protected override void OnInitialized()
    {
        _inputDevices = PortFactory.GetInputDeviceNames();
        _outputDevices = PortFactory.GetOutputDeviceNames();
        _selectedInput = _inputDevices.FirstOrDefault();
        _selectedOutput = _outputDevices.FirstOrDefault();
    }

    protected override async Task OnParametersSetAsync()
    {
        var parsedId = Guid.TryParse(EditDeviceIdRaw, out var id) ? id : (Guid?)null;

        if (parsedId == _loadedForEditId)
        {
            return;
        }

        _loadedForEditId = parsedId;
        _editingDeviceId = null;
        _learnedControls.Clear();
        _deviceName = "";
        _savedDeviceId = null;

        if (parsedId is not { } editId)
        {
            RebuildRecognizer();
            return;
        }

        var device = await Db.ControllerDevices.FirstOrDefaultAsync(d => d.Id == editId && d.DriverKey == GenericDriverConstants.DriverKey);
        if (device is null)
        {
            return;
        }

        _editingDeviceId = device.Id;
        _deviceName = device.Name;
        _selectedInput = device.MidiInputDeviceName ?? _selectedInput;
        _selectedOutput = device.MidiOutputDeviceName ?? _selectedOutput;

        var definitions = await Db.ControllerControlDefinitions.Where(d => d.ControllerDeviceId == editId).ToListAsync();
        _learnedControls.AddRange(definitions.Select(d => new LearnedControlItem
        {
            Name = d.Name,
            Type = d.Type,
            LedCapability = d.LedCapability,
            IsRelative = d.IsRelative,
            Channel = d.Channel,
            CommandCode = d.CommandCode,
            DataNumber = d.DataNumber
        }));

        RebuildRecognizer();
    }

    private void Connect()
    {
        if (_selectedInput is null || _selectedOutput is null)
        {
            return;
        }

        Disconnect();

        _input = PortFactory.OpenInput(_selectedInput);
        _output = PortFactory.OpenOutput(_selectedOutput);
        _input.MessageReceived += OnMessageReceived;
        Snackbar.Add($"Verbunden: {_selectedInput} / {_selectedOutput}", Severity.Success);
    }

    private void Disconnect()
    {
        if (_input is null)
        {
            return;
        }

        _input.MessageReceived -= OnMessageReceived;
        _input.Dispose();
        _output?.Dispose();
        _input = null;
        _output = null;
    }

    private void StartLearning()
    {
        _isLearning = true;
        _pendingCandidate = null;
    }

    private void CancelLearning()
    {
        _isLearning = false;
        _pendingCandidate = null;
    }

    private void OnMessageReceived(object? sender, MidiMessage message)
    {
        var line = $"{DateTime.Now:HH:mm:ss.fff}  ch{message.Channel:00}  status=0x{message.Status:X2}  data1={message.Data1}  data2={message.Data2}";

        InvokeAsync(() =>
        {
            _rawLog.Insert(0, line);
            if (_rawLog.Count > 100)
            {
                _rawLog.RemoveAt(_rawLog.Count - 1);
            }

            if (_isLearning && _pendingCandidate is null && message.CommandCode is 0x90 or 0x80 or 0xB0)
            {
                _pendingCandidate = (message.Channel, message.CommandCode, message.Data1);
                _isLearning = false;
                _pendingName = $"Control {_learnedControls.Count + 1}";
                _pendingType = ControlType.Button;
                _pendingLed = LedCapability.None;
                _pendingIsRelative = false;
            }
            else if (_recognizer.TryGetValue((message.Channel, message.CommandCode, message.Data1), out var learned))
            {
                bool? isOn = learned.Type is ControlType.Pad or ControlType.Button
                    ? message.CommandCode == 0x90 && message.Data2 > 0
                    : null;
                var eventLine = $"{DateTime.Now:HH:mm:ss.fff}  {learned.Name} ({learned.Type})  value={message.Data2 / 127.0:0.00}" + (isOn is null ? "" : $"  isOn={isOn}");
                _controlLog.Insert(0, eventLine);
                if (_controlLog.Count > 100)
                {
                    _controlLog.RemoveAt(_controlLog.Count - 1);
                }
            }

            StateHasChanged();
        });
    }

    private void ConfirmLearnedControl()
    {
        if (_pendingCandidate is not { } candidate)
        {
            return;
        }

        _learnedControls.Add(new LearnedControlItem
        {
            Name = _pendingName,
            Type = _pendingType,
            LedCapability = _pendingLed,
            IsRelative = _pendingType is ControlType.Encoder or ControlType.Fader && _pendingIsRelative,
            Channel = candidate.Channel,
            CommandCode = candidate.CommandCode,
            DataNumber = candidate.DataNumber
        });

        RebuildRecognizer();
        _pendingCandidate = null;
    }

    private void RemoveLearnedControl(LearnedControlItem item)
    {
        _learnedControls.Remove(item);
        RebuildRecognizer();
    }

    private void RebuildRecognizer()
    {
        var entries = new Dictionary<(int, int, int), LearnedControlItem>();

        foreach (var item in _learnedControls)
        {
            if (item.Type is ControlType.Pad or ControlType.Button)
            {
                entries[(item.Channel, 0x90, item.DataNumber)] = item;
                entries[(item.Channel, 0x80, item.DataNumber)] = item;
            }
            else
            {
                entries[(item.Channel, 0xB0, item.DataNumber)] = item;
            }
        }

        _recognizer = entries;
    }

    private void TestLed(LearnedControlItem item)
    {
        if (_output is null)
        {
            return;
        }

        var value = item.LedCapability == LedCapability.Bar ? 100 : 127;
        var message = item.Type is ControlType.Encoder or ControlType.Fader
            ? MidiMessage.ControlChange(item.Channel, item.DataNumber, value)
            : MidiMessage.NoteOn(item.Channel, item.DataNumber, (byte)value);

        _output.Send(message);
    }

    private async Task SaveConfiguration()
    {
        if (string.IsNullOrWhiteSpace(_deviceName) || _learnedControls.Count == 0)
        {
            return;
        }

        if (_editingDeviceId is { } editId)
        {
            var existingDevice = await Db.ControllerDevices.FindAsync(editId);
            if (existingDevice is null)
            {
                return;
            }

            existingDevice.Name = _deviceName;
            existingDevice.MidiInputDeviceName = _selectedInput;
            existingDevice.MidiOutputDeviceName = _selectedOutput;

            var existingDefinitions = await Db.ControllerControlDefinitions.Where(d => d.ControllerDeviceId == editId).ToListAsync();
            Db.ControllerControlDefinitions.RemoveRange(existingDefinitions);

            foreach (var item in _learnedControls)
            {
                Db.ControllerControlDefinitions.Add(new ControllerControlDefinition
                {
                    ControllerDeviceId = editId,
                    Name = item.Name,
                    Type = item.Type,
                    Channel = item.Channel,
                    CommandCode = item.CommandCode,
                    DataNumber = item.DataNumber,
                    LedCapability = item.LedCapability,
                    IsRelative = item.IsRelative
                });
            }

            await Db.SaveChangesAsync();
            _savedDeviceId = editId;
            Snackbar.Add("Änderungen gespeichert", Severity.Success);
            return;
        }

        var device = new ControllerDevice
        {
            Name = _deviceName,
            DriverKey = GenericDriverConstants.DriverKey,
            MidiInputDeviceName = _selectedInput,
            MidiOutputDeviceName = _selectedOutput
        };

        foreach (var item in _learnedControls)
        {
            device.ControlDefinitions.Add(new ControllerControlDefinition
            {
                ControllerDeviceId = device.Id,
                Name = item.Name,
                Type = item.Type,
                Channel = item.Channel,
                CommandCode = item.CommandCode,
                DataNumber = item.DataNumber,
                LedCapability = item.LedCapability,
                IsRelative = item.IsRelative
            });
        }

        Db.ControllerDevices.Add(device);
        await Db.SaveChangesAsync();

        _savedDeviceId = device.Id;
        Snackbar.Add($"Gerät '{device.Name}' gespeichert", Severity.Success);
    }

    public void Dispose() => Disconnect();

    private sealed class LearnedControlItem
    {
        public required string Name { get; set; }
        public required ControlType Type { get; set; }
        public required LedCapability LedCapability { get; set; }
        public bool IsRelative { get; set; }
        public required int Channel { get; init; }
        public required int CommandCode { get; init; }
        public required int DataNumber { get; init; }
    }
}
