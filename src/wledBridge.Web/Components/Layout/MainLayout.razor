@inherits LayoutComponentBase
@using System.Diagnostics
@using wledBridge.Web.Theme

<MudThemeProvider Theme="DarkTheme.Theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0">
        <MudText Typo="Typo.h5">WLED MIDI Bridge</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem OnClick="RestartApp">Neu starten</MudMenuItem>
            <MudMenuItem OnClick="ExitApp">Beenden</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private void RestartApp()
    {
        var exePath = Environment.ProcessPath;

        if (exePath is not null)
        {
            var args = Environment.GetCommandLineArgs();
            var isDotnetHost = Path.GetFileNameWithoutExtension(exePath).Equals("dotnet", StringComparison.OrdinalIgnoreCase);

            var startInfo = new ProcessStartInfo
            {
                FileName = exePath,
                UseShellExecute = false,
                WorkingDirectory = Environment.CurrentDirectory
            };

            // When launched via "dotnet <dll>", args[0] is the dll path and must be passed
            // back to dotnet.exe; when launched as a native apphost, args[0] is the exe path
            // itself and must be dropped.
            var startIndex = isDotnetHost ? 0 : 1;
            for (var i = startIndex; i < args.Length; i++)
            {
                startInfo.ArgumentList.Add(args[i]);
            }

            Process.Start(startInfo);
        }

        ShutdownShortly();
    }

    private void ExitApp() => ShutdownShortly();

    private void ShutdownShortly()
    {
        // A graceful IHostApplicationLifetime.StopApplication() waits for open connections to
        // drain, including the very SignalR circuit this click came in on - which can hang
        // for the whole shutdown timeout. Environment.Exit terminates immediately instead.
        _ = Task.Run(async () =>
        {
            await Task.Delay(300);
            Environment.Exit(0);
        });
    }
}
