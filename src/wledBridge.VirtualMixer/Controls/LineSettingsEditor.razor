@namespace wledBridge.VirtualMixer.Controls
@using wledBridge.VirtualMixer.Components.Internal

<MudSelect T="ControlOrientation" Value="Settings.Orientation" ValueChanged="OnOrientationChanged" Label="Ausrichtung" Margin="Margin.Dense" Dense="true">
    <MudSelectItem T="ControlOrientation" Value="ControlOrientation.Horizontal">Horizontal</MudSelectItem>
    <MudSelectItem T="ControlOrientation" Value="ControlOrientation.Vertical">Vertikal</MudSelectItem>
</MudSelect>

<MudNumericField T="int" Value="Settings.Thickness" ValueChanged="OnThicknessChanged" Label="Dicke (px)" Min="1" Max="64" Margin="Margin.Dense" Class="mt-1" />

<div class="mt-2">
    <VirtualMixerColorPicker Label="Linienfarbe" Value="@Settings.ColorHex" ValueChanged="OnColorChanged" ShowSavePreset="false" />
</div>

<MudText Typo="Typo.caption" Style="opacity:0.7;" Class="mt-1">Länge = Breite (horizontal) bzw. Höhe (vertikal) des Steuerelements.</MudText>

@code {
    [Parameter] public required ControlEditContext Context { get; set; }

    private LineSettings Settings => (LineSettings)Context.Instance.Settings;

    private void OnOrientationChanged(ControlOrientation o) =>
        Context.Update(c => ((LineSettings)c.Settings).Orientation = o, "line-orientation");

    private void OnThicknessChanged(int t) =>
        Context.Update(c => ((LineSettings)c.Settings).Thickness = Math.Clamp(t, 1, 64), "line-thickness");

    private void OnColorChanged(string? color) =>
        Context.Update(c => ((LineSettings)c.Settings).ColorHex = color, "line-color");
}
