@namespace wledBridge.VirtualMixer.Controls
@using wledBridge.VirtualMixer.State
@using wledBridge.VirtualMixer.Components.Internal
@inherits ControlRendererBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="vm-knob" style="position:relative;" @onwheel="OnWheel" @onwheel:preventDefault="@Interactive">
    @if (Settings.LedRingEnabled)
    {
        <svg viewBox="0 0 40 40" style="position:absolute;inset:0;width:100%;height:100%;pointer-events:none;">
            <circle cx="20" cy="20" r="18" fill="none" stroke="var(--mud-palette-lines-default,#444)" stroke-width="2.5" opacity="0.4" />
            @if (RingFraction > 0.001)
            {
                <circle cx="20" cy="20" r="18" fill="none" stroke="@RingColor" stroke-width="2.5" stroke-linecap="round"
                        stroke-dasharray="@RingCircumference" stroke-dashoffset="@RingOffset"
                        transform="rotate(135 20 20)" style="filter:drop-shadow(0 0 2px @RingColor);" />
            }
        </svg>
    }
    <KnobFace Position="@KnobPosition" />
</div>

@code {
    private const double DragPixelsForFullRange = 150.0;
    private const double RelativeTickPixels = 4.0;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _drag;
    private DotNetObjectReference<KnobRenderer>? _selfRef;
    private bool _interactiveAttached;
    private double _dragStartPosition;
    private double _relativeSentPixels;

    // The LED ring spans 270° (like a real knob): fraction 0..1 maps onto that arc.
    private const double RingArcSpan = 0.75; // 270° of the full circle

    private KnobSettings Settings => (KnobSettings)Instance.Settings;

    private bool IsRelative => Settings.Mode == KnobMode.Relative;

    private double? KnobPosition => IsRelative ? null : Settings.Curve.ToPosition(State?.Value ?? 0);

    private double RingFraction
    {
        get
        {
            var value = Settings.LedRingSource == KnobRingSource.External
                ? State?.RingValue ?? 0
                : State?.Value ?? 0;
            return Math.Clamp(value / 127.0, 0.0, 1.0);
        }
    }

    private string RingColor => Settings.LedRingColorMode == LedColorMode.Rgb
        ? Settings.LedRingColorHex ?? ColorUtils.AmberHex
        : ColorUtils.AmberHex;

    // r=18 circle circumference; the visible arc is 270° so the dash pattern uses 3/4 of it.
    private const double FullCircumference = 2 * Math.PI * 18;
    private string RingCircumference =>
        (FullCircumference).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private string RingOffset =>
        (FullCircumference * (1 - (RingFraction * RingArcSpan))).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    [CascadingParameter(Name = "VmScale")] public double Scale { get; set; } = 1.0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Interactive && !_interactiveAttached)
        {
            _interactiveAttached = true;
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/wledBridge.VirtualMixer/virtualmixer.js");
            _selfRef = DotNetObjectReference.Create(this);
            _drag = await _module.InvokeAsync<IJSObjectReference>("attachKnobDrag", _element, _selfRef, new { scale = Scale });
        }
    }

    [JSInvokable]
    public void OnKnobDragStart()
    {
        _dragStartPosition = KnobPosition ?? 0;
        _relativeSentPixels = 0;
    }

    [JSInvokable]
    public async Task OnKnobDrag(double totalDy, bool isFinal)
    {
        if (IsRelative)
        {
            var ticks = (int)((totalDy - _relativeSentPixels) / RelativeTickPixels);
            if (ticks != 0)
            {
                _relativeSentPixels += ticks * RelativeTickPixels;
                await Send(new KnobDeltaCommand(Instance.Id, null, ticks));
            }
        }
        else
        {
            var position = Math.Clamp(_dragStartPosition + (totalDy / DragPixelsForFullRange), 0.0, 1.0);
            await Send(new SetValueCommand(Instance.Id, Settings.Curve.Apply(position), CommandSource.Ui));
        }
    }

    private Task OnWheel(WheelEventArgs e)
    {
        if (!Interactive)
        {
            return Task.CompletedTask;
        }

        var direction = e.DeltaY < 0 ? 1 : -1;
        if (IsRelative)
        {
            return Send(new KnobDeltaCommand(Instance.Id, null, direction));
        }

        var value = Math.Clamp((State?.Value ?? 0) + (direction * 3), 0, 127);
        return Send(new SetValueCommand(Instance.Id, value, CommandSource.Ui));
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        try
        {
            if (_drag is not null)
            {
                await _drag.InvokeVoidAsync("dispose");
                await _drag.DisposeAsync();
            }

            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
    }
}
