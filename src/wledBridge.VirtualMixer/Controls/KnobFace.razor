@namespace wledBridge.VirtualMixer.Controls

@* Presentational rotary knob face (SVG), shared by Knob and KnobBank. *@
<svg viewBox="0 0 40 40" style="width:100%;height:100%;display:block;">
    <circle cx="20" cy="20" r="16" fill="var(--mud-palette-surface, #1e1e1e)"
            stroke="var(--mud-palette-lines-default, #444)" stroke-width="2" />
    @if (Position is { } position)
    {
        var angle = (135.0 + (270.0 * position)) * Math.PI / 180.0;
        var x2 = 20 + (12 * Math.Cos(angle));
        var y2 = 20 + (12 * Math.Sin(angle));
        <line x1="20" y1="20"
              x2="@x2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
              y2="@y2.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
              stroke="@Color" stroke-width="3" stroke-linecap="round" />
    }
    else
    {
        @* Relative (endless) knob: center dot + tick marks instead of a position. *@
        <circle cx="20" cy="20" r="3" fill="@Color" />
        <line x1="20" y1="6" x2="20" y2="10" stroke="@Color" stroke-width="2" />
        <line x1="20" y1="30" x2="20" y2="34" stroke="@Color" stroke-width="2" />
        <line x1="6" y1="20" x2="10" y2="20" stroke="@Color" stroke-width="2" />
        <line x1="30" y1="20" x2="34" y2="20" stroke="@Color" stroke-width="2" />
    }
</svg>

@code {
    /// <summary>Normalized position 0..1, or null for a relative (endless) knob.</summary>
    [Parameter] public double? Position { get; set; }

    [Parameter] public string Color { get; set; } = "var(--mud-palette-primary, #01FF95)";
}
